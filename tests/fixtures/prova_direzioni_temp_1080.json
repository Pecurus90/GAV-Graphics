{
  "_nota": "SCAFFOLDING DI VERIFICA (non un prodotto). Mostra i due dati nuovi di #6c: (1) planet_panel che usa il campo NUOVO {direction}; (2) swatches con la SECONDA etichetta (label2) = legenda delle temperature stellari. I valori di temperatura sono quelli del DESIGNER (fedeli al mockup): la loro correttezza e' discussa nel report. Palette notte-blu, cosi' i colori coincidono con quelli del mockup.",
  "canvas": {"w": 1080, "h": 640, "font_family": "Helvetica,Arial,sans-serif"},
  "blocks": [
    {"type": "background",
     "starfield": {"seed": 7, "count": 160, "r_min": 0.3, "r_max": 1.0,
                   "op_min": 0.12, "op_max": 0.4, "fill": "bgstar"}},

    {"type": "text", "x": 540, "y": 66, "fill": "gold", "size": 28,
     "weight": "bold", "anchor": "middle", "letter_spacing": 2,
     "content": "PROVA #6c - DIREZIONE PIANETI + LEGENDA TEMPERATURE"},

    {"type": "text", "x": 70, "y": 130, "fill": "text", "size": 18,
     "weight": "bold", "letter_spacing": 1,
     "content": "PIANETI A OCCHIO NUDO - {month_upper} {year}"},
    {"type": "planet_panel", "from": "planets", "statuses": ["ok", "info"],
     "x0": 70, "y0": 170, "step": 46,
     "dot":   {"dx": 6, "dy": -4, "r": 5, "fill_status": true},
     "name":  {"dx": 22, "fill": "text",  "size": 16, "weight": "bold", "content": "{name}"},
     "times": {"dx": 150, "fill": "text2", "size": 14, "content": "{rise} / {set}"},
     "note":  {"dx": 22, "dy": 18, "fill": "text3", "size": 13, "content": "{note} - {direction}"}},

    {"type": "text", "x": 70, "y": 470, "fill": "text", "size": 18,
     "weight": "bold", "letter_spacing": 1,
     "content": "COLORE DELLE STELLE = TEMPERATURA"},
    {"type": "swatches", "from": "ramp", "x0": 95, "cy": 520, "step": 162, "r": 10,
     "label":  {"dx": -30, "dy": 34, "fill": "text",  "size": 14, "weight": "600"},
     "label2": {"dx": -30, "dy": 54, "fill": "text3", "size": 12},
     "items": [
       {"bv": -0.33, "label": "Blu",            "label2": "oltre 10.000 K"},
       {"bv": 0.0,   "label": "Bianco-azzurra", "label2": "≈ 8.000 K"},
       {"bv": 0.4,   "label": "Bianca",         "label2": "≈ 6.500 K"},
       {"bv": 0.59,  "label": "Gialla",         "label2": "≈ 5.800 K · Sole"},
       {"bv": 1.3,   "label": "Arancione",      "label2": "≈ 4.500 K"},
       {"bv": 3.3,   "label": "Rossa",          "label2": "sotto 3.500 K"}]}
  ]
}
