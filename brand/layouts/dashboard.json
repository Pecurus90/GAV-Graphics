{
  "scheda": {"nome": "Dashboard", "tag": "4:5 · mappa + pannelli", "aspect": "45", "ordine": 1},
  "_nota": "Design 'dashboard' (docs/mockups/dashboard.svg) come DATI. Testata a sinistra, disco a sinistra, colonna destra con pannello pianeti + legenda colori; calendario lunare a riga da 31 in basso. Colori = TOKEN del tema (mai hex): regge tutte le palette. Font del brand (D4). FORMATO 4:5 (1080x1350, il verticale di Instagram) dal 2026-10-08: prima era quadrato 1080x1080. La colonna destra si STRINGE (334 -> 240 px: la nota piu' lunga misura 172) e si ALLUNGA sull'altezza nuova; lo spazio liberato va al disco, rad 270 -> 334. Nella legenda la temperatura scende SOTTO il nome (in 240 px non stanno piu' sulla stessa riga). Per la stessa ragione nota e direzione del pianeta stanno su DUE righe: unite arrivano a 216 px (\"Telescopico, a fine notte · basso a Est\"). La direzione usa la parte 'times' del blocco planet_panel, libera da quando gli orari sono stati tolti (#7o).",
  "canvas": {"w": 1080, "h": 1350, "font_family": "Space Grotesk, Work Sans, Helvetica, Arial, sans-serif"},
  "blocks": [
    {"type": "background",
     "starfield": {"seed": 7, "count": 220, "r_min": 0.4, "r_max": 1.6,
                   "op_min": 0.12, "op_max": 0.5, "fill": "bgstar", "fill_alt": "gold", "alt_frac": 0.25}},

    {"type": "image", "href": "brand/logo/logo-emblema.png",
     "x": 56, "y": 74, "w": 100, "h": 100},
    {"type": "text", "x": 182, "y": 84, "fill": "gold", "size": 16,
     "weight": "600", "letter_spacing": 1.28, "content": "GRUPPO ASTROFILI VICENTINI “GIORGIO ABETTI” · APS"},
    {"type": "text", "x": 182, "y": 150, "fill": "text", "size": 56,
     "weight": "800", "letter_spacing": -1.12, "content": "Il cielo di {month_name} {year}"},
    {"type": "text", "x": 182, "y": 184, "fill": "text3", "size": 15,
     "font_family": "Work Sans, Helvetica, Arial, sans-serif", "content": "Cielo visibile dal Nord Italia · {place} · valido ~15 {month_name}, ore {hour}:00"},
    {"type": "line", "x1": 56, "y1": 206, "x2": 1024, "y2": 206,
     "stroke": "divider", "stroke_width": 1},

    {"type": "disc", "cx": 400, "cy": 640, "rad": 334,
     "declutter": true, "label_halo": 2.6, "ticks": {"minor": 10, "major": 30},
     "labels": ["UMa", "UMi", "Cas", "Cep", "Dra", "Cyg", "Lyr", "Aql", "Her",
                "CrB", "Boo", "Sco", "Sgr", "Peg", "And", "Per", "Aur", "Ori",
                "Tau", "Gem", "Leo", "CMa",
                "Ari", "Cnc", "Vir", "Lib", "Cap", "Aqr", "Psc"],
     "star_names": ["Sirio", "Vega", "Altair", "Deneb", "Arturo", "Capella",
                    "Rigel", "Betelgeuse", "Aldebaran", "Pollux", "Regolo",
                    "Antares", "Spica", "Fomalhaut", "Polare",
                    "Mizar", "Schedar", "Thuban", "Alphecca", "Kaus Australis",
                    "Mirach", "Algol", "Enif"]},

    {"type": "panel", "x": 784, "y": 234, "w": 240, "h": 456, "rx": 12,
     "fill": "panel", "stroke": "border2", "stroke_width": 1},
    {"type": "text", "x": 804, "y": 268, "fill": "label", "size": 13,
     "weight": "600", "letter_spacing": 1.04, "content": "PIANETI VISIBILI"},
    {"type": "line", "x1": 804, "y1": 282, "x2": 1004, "y2": 282,
     "stroke": "divider", "stroke_width": 1},
    {"type": "planet_panel", "from": "planets",
     "x0": 804, "y0": 308, "step": 56,
     "dot":   {"dx": 8, "dy": -4, "r": 6.5, "fill_planet": true,
               "ring": {"stroke": "moon_lit", "width": 1.4, "rx": 1.75}},
     "name":  {"dx": 34, "fill": "text",  "size": 16, "weight": "600", "content": "{name}"},
     "note":  {"font_family": "Work Sans, Helvetica, Arial, sans-serif", "dx": 28, "dy": 16, "fill": "text3", "size": 11.5, "content": "{note}"},
     "times": {"font_family": "Work Sans, Helvetica, Arial, sans-serif", "dx": 28, "dy": 30, "fill": "text3", "size": 11.5, "content": "{direction}"}},

    {"type": "panel", "x": 784, "y": 706, "w": 240, "h": 332, "rx": 12,
     "fill": "panel", "stroke": "border2", "stroke_width": 1},
    {"type": "text", "x": 804, "y": 740, "fill": "label", "size": 13,
     "weight": "600", "letter_spacing": 1.04, "content": "TEMPERATURA STELLE"},
    {"type": "line", "x1": 804, "y1": 754, "x2": 1004, "y2": 754,
     "stroke": "divider", "stroke_width": 1},
    {"type": "swatches", "from": "ramp", "x0": 812, "cy": 780, "r": 7,
     "cols": 1, "col_step": 0, "row_step": 44,
     "label":  {"dx": 20, "dy": 2, "fill": "text",  "size": 14, "weight": "600"},
     "label2": {"dx": 20, "dy": 19, "fill": "text3", "size": 11.5},
     "items": [
       {"bv": -0.33, "label": "Blu",            "label2": "oltre 15.000 K"},
       {"bv": 0.0,   "label": "Bianco-azzurra", "label2": "≈ 10.000 K"},
       {"bv": 0.4,   "label": "Bianca",         "label2": "≈ 7.000 K"},
       {"bv": 0.65,  "label": "Gialla",         "label2": "≈ 5.800 K · come il Sole"},
       {"bv": 1.3,   "label": "Arancione",      "label2": "≈ 4.000 K"},
       {"bv": 3.3,   "label": "Rossa",          "label2": "sotto 3.000 K"}]},

    {"type": "text", "x": 56, "y": 1088, "fill": "label", "size": 13,
     "weight": "600", "letter_spacing": 1.04, "content": "FASI LUNARI · {month_upper}"},
    {"type": "line", "x1": 56, "y1": 1096, "x2": 1024, "y2": 1096,
     "stroke": "divider", "stroke_width": 1},
    {"type": "moon_calendar", "cols": 31,
     "x0": 71.6, "y0": 1132, "col_gap": 31.22, "row_gap": 0, "radius": 10.5,
     "base": {"fill": "panel", "stroke": "border2", "stroke_width": 0.8},
     "lit_fill": "moon_lit",
     "highlight": {"stroke": "gold", "stroke_width": 1.6, "r_extra": 3.5},
     "day_number": {"dy": 26.5, "fill": "text2", "size": 11, "fill_highlight": "gold"},
     "phase_labels": {"font_family": "Work Sans, Helvetica, Arial, sans-serif", "y": 1194, "fill": "moon_label",
                      "size": 12, "weight": "600", "content": "{day} {name}",
                      "names": {"new": "Luna Nuova", "first": "Primo Q.",
                                "full": "Luna Piena", "last": "Ultimo Q."}}},

    {"type": "line", "x1": 56, "y1": 1270, "x2": 1024, "y2": 1270,
     "stroke": "divider", "stroke_width": 1},
    {"type": "icon", "name": "instagram", "x": 56, "y": 1291, "size": 16, "fill": "gold"},
    {"type": "text", "x": 80, "y": 1304, "fill": "text3", "size": 13, "weight": "500",
     "font_family": "Work Sans, Helvetica, Arial, sans-serif", "content": "@astrofilivicentini"},
    {"type": "icon", "name": "facebook", "x": 248, "y": 1291, "size": 16, "fill": "gold"},
    {"type": "text", "x": 272, "y": 1304, "fill": "text3", "size": 13, "weight": "500",
     "font_family": "Work Sans, Helvetica, Arial, sans-serif", "content": "Gruppo Astrofili Vicentini"},
    {"type": "icon", "name": "email", "x": 512, "y": 1291, "size": 16, "fill": "gold"},
    {"type": "text", "x": 536, "y": 1304, "fill": "text3", "size": 13, "weight": "500",
     "font_family": "Work Sans, Helvetica, Arial, sans-serif", "content": "info@astrofilivicentini.it"}
  ]
}
