{
  "scheda": {"nome": "Dashboard", "tag": "Quadrato · mappa + pannelli", "aspect": "sq", "ordine": 1},
  "_nota": "Design 'dashboard' (docs/mockups/dashboard.svg) come DATI. Testata a sinistra, disco a sinistra, colonna destra con pannello pianeti + legenda colori; calendario lunare a riga da 31 in basso. Colori = TOKEN del tema (mai hex): regge tutte le palette. Font del brand (D4).",
  "canvas": {"w": 1080, "h": 1080, "font_family": "Barlow Semi Condensed, Instrument Sans, Helvetica, Arial, sans-serif"},
  "blocks": [
    {"type": "background",
     "starfield": {"seed": 7, "count": 220, "r_min": 0.4, "r_max": 1.6,
                   "op_min": 0.12, "op_max": 0.5, "fill": "bgstar"}},

    {"type": "image", "href": "brand/logo/logo-emblema.png",
     "x": 56, "y": 74, "w": 100, "h": 100},
    {"type": "text", "x": 180, "y": 84, "fill": "gold", "size": 16,
     "weight": "600", "letter_spacing": 3.6, "content": "GRUPPO ASTROFILI VICENTINI"},
    {"type": "text", "x": 178, "y": 150, "fill": "text", "size": 56,
     "weight": "800", "letter_spacing": 0.5, "content": "Il cielo di {month_name} {year}"},
    {"type": "text", "x": 180, "y": 184, "fill": "text3", "size": 15,
     "content": "Cielo visibile dal Nord Italia · {place} · valido ~15 {month_name}, ore {hour}:00"},
    {"type": "line", "x1": 56, "y1": 206, "x2": 1024, "y2": 206,
     "stroke": "divider", "stroke_width": 1},

    {"type": "disc", "cx": 340, "cy": 520, "rad": 270,
     "declutter": true, "ticks": {"minor": 10, "major": 30},
     "labels": ["UMa", "UMi", "Cas", "Cep", "Dra", "Cyg", "Lyr", "Aql", "Her",
                "CrB", "Boo", "Sco", "Sgr", "Peg", "And", "Per", "Aur", "Ori",
                "Tau", "Gem", "Leo", "CMa",
                "Ari", "Cnc", "Vir", "Lib", "Cap", "Aqr", "Psc"],
     "star_names": ["Sirio", "Vega", "Altair", "Deneb", "Arturo", "Capella",
                    "Rigel", "Betelgeuse", "Aldebaran", "Pollux", "Regolo",
                    "Antares", "Spica", "Fomalhaut", "Polare",
                    "Mizar", "Schedar", "Thuban", "Alphecca", "Kaus Australis",
                    "Mirach", "Algol", "Enif"]},

    {"type": "panel", "x": 690, "y": 234, "w": 334, "h": 314, "rx": 16,
     "fill": "panel", "stroke": "border2", "stroke_width": 1},
    {"type": "text", "x": 712, "y": 268, "fill": "label", "size": 13,
     "weight": "600", "letter_spacing": 2.2, "content": "PIANETI VISIBILI"},
    {"type": "line", "x1": 712, "y1": 282, "x2": 1002, "y2": 282,
     "stroke": "divider", "stroke_width": 1},
    {"type": "planet_panel", "from": "planets",
     "x0": 712, "y0": 302, "step": 35,
     "dot":   {"dx": 8, "dy": -4, "r": 6.5, "fill_planet": true,
               "ring": {"stroke": "moon_lit", "width": 1.4, "rx": 1.75}},
     "name":  {"dx": 34, "fill": "text",  "size": 16, "weight": "600", "content": "{name}"},
     "note":  {"dx": 28, "dy": 16, "fill": "text3", "size": 11.5, "content": "{note_dir}"}},

    {"type": "panel", "x": 690, "y": 564, "w": 334, "h": 245, "rx": 16,
     "fill": "panel", "stroke": "border2", "stroke_width": 1},
    {"type": "text", "x": 712, "y": 598, "fill": "label", "size": 13,
     "weight": "600", "letter_spacing": 2.2, "content": "TEMPERATURA STELLE"},
    {"type": "text", "x": 1002, "y": 598, "fill": "text4", "size": 11,
     "anchor": "end", "content": "temperatura"},
    {"type": "line", "x1": 712, "y1": 612, "x2": 1002, "y2": 612,
     "stroke": "divider", "stroke_width": 1},
    {"type": "swatches", "from": "ramp", "x0": 720, "cy": 632, "r": 7,
     "cols": 1, "col_step": 0, "row_step": 30,
     "label":  {"dx": 20, "dy": 4, "fill": "text",  "size": 14, "weight": "600"},
     "label2": {"dx": 282, "dy": 4, "anchor": "end", "fill": "text3", "size": 11.5},
     "items": [
       {"bv": -0.33, "label": "Blu",            "label2": "oltre 15.000 K"},
       {"bv": 0.0,   "label": "Bianco-azzurra", "label2": "≈ 10.000 K"},
       {"bv": 0.4,   "label": "Bianca",         "label2": "≈ 7.000 K"},
       {"bv": 0.65,  "label": "Gialla",         "label2": "≈ 5.800 K · come il Sole"},
       {"bv": 1.3,   "label": "Arancione",      "label2": "≈ 4.000 K"},
       {"bv": 3.3,   "label": "Rossa",          "label2": "sotto 3.000 K"}]},

    {"type": "text", "x": 56, "y": 818, "fill": "label", "size": 13,
     "weight": "600", "letter_spacing": 2.2, "content": "FASI LUNARI · {month_upper}"},
    {"type": "line", "x1": 56, "y1": 826, "x2": 1024, "y2": 826,
     "stroke": "divider", "stroke_width": 1},
    {"type": "moon_calendar", "cols": 31,
     "x0": 71.6, "y0": 862, "col_gap": 31.22, "row_gap": 0, "radius": 10.5,
     "base": {"fill": "panel", "stroke": "border2", "stroke_width": 0.8},
     "lit_fill": "moon_lit",
     "highlight": {"stroke": "gold", "stroke_width": 1.6, "r_extra": 3.5},
     "day_number": {"dy": 26.5, "fill": "text2", "size": 11, "fill_highlight": "gold"},
     "phase_labels": {"y": 924, "fill": "moon_label",
                      "size": 12, "weight": "600", "content": "{day} {name}",
                      "names": {"new": "Luna Nuova", "first": "Primo Q.",
                                "full": "Luna Piena", "last": "Ultimo Q."}}},

    {"type": "line", "x1": 56, "y1": 1000, "x2": 1024, "y2": 1000,
     "stroke": "divider", "stroke_width": 1},
    {"type": "icon", "name": "instagram", "x": 56, "y": 1021, "size": 16, "fill": "text3"},
    {"type": "text", "x": 80, "y": 1034, "fill": "text3", "size": 13, "weight": "500",
     "content": "@astrofilivicentini"},
    {"type": "icon", "name": "facebook", "x": 248, "y": 1021, "size": 16, "fill": "text3"},
    {"type": "text", "x": 272, "y": 1034, "fill": "text3", "size": 13, "weight": "500",
     "content": "Gruppo Astrofili Vicentini"},
    {"type": "icon", "name": "email", "x": 512, "y": 1021, "size": 16, "fill": "text3"},
    {"type": "text", "x": 536, "y": 1034, "fill": "text3", "size": 13, "weight": "500",
     "content": "info@astrofilivicentini.it"}
  ]
}
